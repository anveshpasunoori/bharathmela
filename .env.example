# Postgres. Locally: `docker compose up -d` and keep this value. In production, your managed Postgres URL
# (Neon, Supabase, RDS…), usually with ?sslmode=require.
DATABASE_URL="postgresql://bharathmela:bharathmela@localhost:5432/bharathmela"

# Shown to vendors on the payment page. Payments are confirmed manually in /admin.
PAY_ZELLE="payments@example.com"
PAY_VENMO="@your-venmo-handle"

# Used by `npm run db:seed` to create the admin account (dev only).
SEED_ADMIN_EMAIL="admin@bharathmela.test"
SEED_ADMIN_PASSWORD="admin-dev-password"

# AI ad writer (Pro plan). Leave empty to disable.
ANTHROPIC_API_KEY=""

# Verification emails via Resend. When empty, codes are printed to the server log (dev only).
RESEND_API_KEY=""
EMAIL_FROM="BharathMela <no-reply@yourdomain.com>"

# Text messages for seller phone verification via Twilio. When empty, codes are printed to the server log (dev only).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Public address of the site, for links in emails (saved-search alerts).
APP_URL="http://localhost:3000"

# The daily job (/api/cron/daily: expiries, reminders, saved-search alerts, cleanup) runs when called with "Authorization: Bearer <CRON_SECRET>"
# (Vercel Cron sends this). In development it also works without it: `npm run daily`.
CRON_SECRET=""

# Google Search Console "HTML tag" verification code (just the content value). Optional.
GOOGLE_SITE_VERIFICATION=""

# Photo storage: any S3-compatible bucket (Cloudflare R2, AWS S3, Backblaze B2). Without S3_BUCKET, photos go
# to public/uploads on local disk (development only). For R2: S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com",
# S3_REGION="auto", and S3_PUBLIC_URL is the bucket's public r2.dev URL or a custom domain such as https://photos.example.com.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""
