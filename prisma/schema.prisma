// Postgres everywhere: locally from docker-compose.yml, in production a managed database (see DEPLOY.md).
// Status/role fields are plain strings; allowed values live in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  passwordHash     String
  name             String
  role             String           @default("VENDOR") // VENDOR | BUYER | ADMIN
  // Set once the user enters the code we emailed them. Required before rating.
  emailVerifiedAt  DateTime?
  emailCodes       EmailCode[]
  phoneCodes       PhoneCode[]
  reviews          Review[]
  roomsWanted      RoomWanted[]
  favorites        Favorite[]
  savedSearches    SavedSearch[]
  serviceRequests  ServiceRequest[]
  sentMessages     Message[]        @relation("SentMessages")
  receivedMessages Message[]        @relation("ReceivedMessages")
  // Proof the seller agreed to the Terms; see TERMS_VERSION in src/lib/legal.ts.
  termsVersion     String?
  termsAcceptedAt  DateTime?
  // Last time the user was signed in and using the site, for "Active recently" badges.
  lastSeenAt       DateTime?
  // Set once the user confirms a texted code; phone itself lives on VendorProfile.
  phoneVerifiedAt  DateTime?
  // Suspended users can't log in and their listings and reviews are hidden.
  suspendedAt      DateTime?
  suspendReason    String           @default("")
  // Account deletion anonymizes the user but keeps payment records.
  deletedAt        DateTime?
  // Where the person first came from (utm_source / utm_campaign on their first visit, or "referral").
  signupSource     String           @default("")
  signupCampaign   String           @default("")
  // Monthly "new in your city" email: opt-in only, for the chosen metro, with one-click unsubscribe.
  cityEmails       Boolean          @default(false)
  cityEmailMetro   String?
  cityEmailSentAt  DateTime?
  cityEmailToken   String           @unique @default(cuid())
  reviewRequests   ReviewRequest[]
  passwordResets   PasswordReset[]
  // A new address waiting for its emailed code before it replaces `email`.
  pendingEmail     String?
  createdAt        DateTime         @default(now())
  sessions         Session[]
  vendor           VendorProfile?
  reviewed         Payment[]        @relation("ReviewedBy")
}

model Session {
  id        String   @id // random token stored in the cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model VendorProfile {
  id                 String          @id @default(cuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName       String
  phone              String
  whatsapp           Boolean         @default(false) // phone number also takes WhatsApp messages
  metro              String // metro slug, see src/lib/metros.ts
  zip                String
  about              String          @default("")
  // One of the first sellers in their city, given free Pro (see src/lib/growth.ts).
  foundingSeller     Boolean         @default(false)
  // Set by an admin after checking the business is real (license, registration or a shop visit).
  businessVerifiedAt DateTime?
  // The seller whose referral link this seller signed up through; rewarded once this seller posts a listing.
  referredById       String?
  referredBy         VendorProfile?  @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          VendorProfile[] @relation("Referrals")
  referralRewardedAt DateTime?
  createdAt          DateTime        @default(now())
  reviewRequests     ReviewRequest[]
  leads              Lead[]
  listings           Listing[]
  subscriptions      Subscription[]
  payments           Payment[]
  aiDrafts           AiDraft[]
  reviews            Review[]
  events             Event[]
  quotes             Quote[]
}

// One-time code texted to prove a seller owns their phone number.
model PhoneCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// One-time code emailed to prove the user owns their address.
model EmailCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A verified buyer's rating of a seller. One per buyer per seller; editing replaces it.
model Review {
  id              String        @id @default(cuid())
  vendorId        String
  vendor          VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  buyerId         String
  buyer           User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  rating          Int // 1-5
  comment         String        @default("")
  status          String        @default("VISIBLE") // VISIBLE | HIDDEN (removed by admin)
  vendorReply     String        @default("")
  vendorRepliedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([vendorId, buyerId])
}

// One row per AI ad-writer use, for the daily limit.
model AiDraft {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([vendorId, createdAt])
}

model Listing {
  id             String         @id @default(cuid())
  vendorId       String
  vendor         VendorProfile  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  leads          Lead[]
  title          String
  description    String
  category       String
  priceCents     Int?
  priceUnit      String         @default("") // e.g. "per plate", "per hour"
  // Dietary tags for food, stored as ",VEGAN,GLUTEN_FREE," so a tag can be matched with `contains`.
  tags           String         @default("")
  // Category-specific structured fields as JSON (room rentals: see RentalDetails in src/lib/rentals.ts).
  details        String         @default("{}")
  metro          String
  zip            String
  // ACTIVE | HIDDEN (by seller) | PENDING_REVIEW | REJECTED | REMOVED (by admin)
  status         String         @default("ACTIVE")
  moderationNote String         @default("") // why it was held, rejected or removed
  views          Int            @default(0)
  updatedAt      DateTime       @default(now()) @updatedAt
  // Listings go stale: they stop showing after this date unless the seller renews them.
  // Set on create and on renew (see LISTING_DAYS in src/lib/listings.ts).
  expiresAt      DateTime?
  expiryWarnedAt DateTime?
  // Denormalized from approved ad boosts so browse can sort featured listings first.
  featuredUntil  DateTime?
  createdAt      DateTime       @default(now())
  boosts         AdBoost[]
  reports        Report[]
  favorites      Favorite[]
  messages       Message[]
  photos         ListingPhoto[]

  @@index([metro, category, status])
}

// A user's complaint about a listing, event or room-wanted post (exactly one is set).
model Report {
  id               String          @id @default(cuid())
  listingId        String?
  listing          Listing?        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  eventId          String?
  event            Event?          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomWantedId     String?
  roomWanted       RoomWanted?     @relation(fields: [roomWantedId], references: [id], onDelete: Cascade)
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  reason           String // see REPORT_REASONS in src/lib/legal.ts
  details          String          @default("")
  reporterEmail    String          @default("")
  status           String          @default("OPEN") // OPEN | ACTIONED | DISMISSED
  createdAt        DateTime        @default(now())
  resolvedAt       DateTime?

  @@index([status])
}

// A paid monthly plan. Free plan has no row: no active subscription means FREE.
model Subscription {
  id        String        @id @default(cuid())
  vendorId  String
  vendor    VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  plan      String // BASIC | PRO
  status    String        @default("PENDING") // PENDING | ACTIVE | EXPIRED | REJECTED
  source    String        @default("PAID") // PAID | FOUNDING | REFERRAL (free months, no payment)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime      @default(now())
  payment   Payment?
}

// A paid "featured" placement for one listing.
model AdBoost {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  days      Int
  status    String    @default("PENDING") // PENDING | ACTIVE | EXPIRED | REJECTED
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  payment   Payment?
}

// What a vendor paid us, for either a subscription or an ad boost.
// Manually reviewed by an admin today; a Stripe webhook can mark these APPROVED later.
model Payment {
  id             String        @id @default(cuid())
  vendorId       String
  vendor         VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  purpose        String // SUBSCRIPTION | AD_BOOST
  subscriptionId String?       @unique
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  adBoostId      String?       @unique
  adBoost        AdBoost?      @relation(fields: [adBoostId], references: [id], onDelete: Cascade)
  amountCents    Int
  method         String // ZELLE | VENMO | OTHER
  reference      String
  status         String        @default("PENDING") // PENDING | APPROVED | REJECTED
  adminNote      String        @default("")
  reviewedById   String?
  reviewedBy     User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())

  @@index([status])
}

// Every admin action, for accountability.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // e.g. "payment.approve", "listing.remove", "user.suspend"
  targetType String
  targetId   String
  details    String   @default("")
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// A dated happening posted by a seller acting as organizer: concerts, dance shows,
// festival celebrations, pujas, community meetups. Goes through the same moderation as listings.
model Event {
  id             String        @id @default(cuid())
  vendorId       String
  vendor         VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  title          String
  description    String
  type           String // see EVENT_TYPES in src/lib/events.ts
  festival       String        @default("") // see FESTIVALS in src/lib/events.ts
  startsAt       DateTime
  endsAt         DateTime
  venueName      String
  address        String
  metro          String
  isFree         Boolean       @default(true)
  priceCents     Int? // lowest ticket price when not free
  ticketUrl      String        @default("")
  // ACTIVE | HIDDEN (by organizer) | PENDING_REVIEW | REJECTED | REMOVED (by admin)
  status         String        @default("ACTIVE")
  moderationNote String        @default("")
  views          Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  reports        Report[]

  @@index([metro, status, startsAt])
}

// "I need a place to live": a renter describes what they're looking for, and owners contact them.
// Any verified user can post; posts expire so stale requests don't pile up.
model RoomWanted {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  metro            String
  title            String
  description      String
  budgetMaxCents   Int
  moveInDate       String // YYYY-MM-DD
  lease            String // see LEASES in src/lib/rentals.ts
  spaceTypes       String // ",PRIVATE_ROOM,PAYING_GUEST," (see SPACE_TYPES)
  areas            String    @default("") // preferred neighborhoods or cities
  needsPrivateBath Boolean   @default(false)
  needsFurnished   Boolean   @default(false)
  needsParking     Boolean   @default(false)
  hasPets          Boolean   @default(false)
  // ACTIVE | HIDDEN (by poster) | PENDING_REVIEW | REJECTED | REMOVED (by admin)
  status           String    @default("ACTIVE")
  moderationNote   String    @default("")
  expiresAt        DateTime
  views            Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  reports          Report[]
  messages         Message[]

  @@index([metro, status, expiresAt])
}

// A message relayed by email between users (owner → renter, buyer → seller), kept for abuse checks.
model Message {
  id           String      @id @default(cuid())
  fromUserId   String
  fromUser     User        @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId     String
  toUser       User        @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)
  roomWantedId String?
  roomWanted   RoomWanted? @relation(fields: [roomWantedId], references: [id], onDelete: SetNull)
  listingId    String?
  listing      Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  body         String
  createdAt    DateTime    @default(now())

  @@index([fromUserId, createdAt])
  @@index([toUserId, createdAt])
}

// A buyer's shortlist.
model Favorite {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, listingId])
}

// Listing photos, resized and stripped of metadata (including GPS) on upload. position 0 is the cover.
model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String // full-size image, e.g. /uploads/listings/<listingId>/<id>.webp
  thumbUrl  String
  width     Int
  height    Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId, position])
}

// A search a user saved to come back to, with optional email alerts for new matches. `params` is the
// results page's query string (category, keywords, filters); the location is kept here because the
// visitor's own location lives only in a cookie on their device.
model SavedSearch {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  params           String    @default("")
  metro            String
  // Set for "within N miles of" searches, rounded like the location cookie (~1 km).
  nearLat          Float?
  nearLng          Float?
  nearCity         String    @default("")
  radiusMiles      Int?
  alerts           String    @default("DAILY") // DAILY | WEEKLY | OFF
  // Listings published after this were not in an alert yet.
  alertedUntil     DateTime  @default(now())
  lastAlertAt      DateTime?
  // Listings published after this count as "new" on the Saved page.
  viewedAt         DateTime  @default(now())
  // For one-click unsubscribe links in alert emails.
  unsubscribeToken String    @unique @default(cuid())
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([alerts, lastAlertAt])
}

// "Post what you need": a buyer describes a job once, nearby sellers in that category are emailed, and
// they answer with a quote. The buyer's email stays private until they reply to a seller.
model ServiceRequest {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String
  serviceType    String   @default("") // one of the category's service types, if it has them
  title          String
  description    String
  neededBy       String   @default("") // YYYY-MM-DD, or "" for flexible
  budgetCents    Int?
  zip            String
  city           String   @default("")
  metro          String
  lat            Float
  lng            Float
  status         String   @default("OPEN") // OPEN | CLOSED (by the buyer) | PENDING_REVIEW | REMOVED
  moderationNote String   @default("")
  notifiedCount  Int      @default(0)
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  quotes         Quote[]
  reports        Report[]

  @@index([status, category, metro])
  @@index([userId])
}

// A seller's answer to a request: one per seller, emailed to the buyer with the seller as reply-to.
model Quote {
  id         String         @id @default(cuid())
  requestId  String
  request    ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     VendorProfile  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  message    String
  priceCents Int?
  priceUnit  String         @default("")
  createdAt  DateTime       @default(now())

  @@unique([requestId, vendorId])
}

// Rate-limit counters (src/lib/rate-limit.ts), shared by every server instance. Old rows are cleared daily.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// A "how was it?" email sent to a buyer a few days after they messaged a seller; one per buyer and seller.
model ReviewRequest {
  id       String        @id @default(cuid())
  buyerId  String
  buyer    User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  sentAt   DateTime      @default(now())

  @@unique([buyerId, vendorId])
}

// A "forgot password" link: only the token's hash is stored; it works once, for an hour.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// A buyer tapping Call, Text or WhatsApp on a seller's listing or page: counted once per visitor, seller and
// kind each day, and shown to the seller as leads.
model Lead {
  id         String        @id @default(cuid())
  vendorId   String
  vendor     VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  listingId  String?
  listing    Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  kind       String // CALL | TEXT | WHATSAPP
  visitorKey String // hash of the visitor and the day, for counting each visitor once a day
  createdAt  DateTime      @default(now())

  @@unique([vendorId, kind, visitorKey])
  @@index([vendorId, createdAt])
}
